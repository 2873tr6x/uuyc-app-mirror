{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UU Remote archive manifest v1",
  "type": "object",
  "required": ["schema_version", "product", "observed_at", "tag", "snapshot_sha256", "official_download_page", "run_url", "source_commit", "packages", "store_only"],
  "properties": {
    "schema_version": {"const": 1},
    "product": {"const": "UU Remote"},
    "observed_at": {"type": "string", "format": "date-time"},
    "tag": {"type": "string", "pattern": "^uuyc-[a-f0-9]{20}$"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "official_download_page": {"type": "string", "format": "uri"},
    "run_url": {"type": "string", "format": "uri"},
    "source_commit": {"type": ["string", "null"]},
    "store_only": {"type": "object", "required": ["ios"], "properties": {"ios": {"type": "string", "format": "uri"}}},
    "packages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["platform", "version", "version_source", "architecture", "landing_url", "endpoint_url", "resolved_url", "upstream_filename", "asset_name", "http", "size", "sha256"],
        "properties": {
          "platform": {"enum": ["windows", "macos", "android", "android-tv"]},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
          "version_source": {"const": "official-filename"},
          "architecture": {"const": "unspecified-by-download-page"},
          "landing_url": {"type": "string", "format": "uri"},
          "endpoint_url": {"type": "string", "format": "uri"},
          "resolved_url": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+$"},
          "upstream_filename": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "asset_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "http": {
            "type": "object",
            "required": ["etag", "last-modified", "content-length", "content-type"],
            "properties": {
              "etag": {"type": ["string", "null"]},
              "last-modified": {"type": ["string", "null"]},
              "content-length": {"type": ["string", "null"]},
              "content-type": {"type": ["string", "null"]}
            }
          },
          "size": {"type": "integer", "minimum": 1024, "maximum": 1999999999},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      },
      "allOf": [
        {"contains": {"properties": {"platform": {"const": "windows"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"platform": {"const": "macos"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"platform": {"const": "android"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"platform": {"const": "android-tv"}}}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
